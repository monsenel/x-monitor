# --- Server ---
PORT=3000
DATABASE_PATH=
TZ=Asia/Tehran

# --- Admin login (generate the hash with: npm run hash-password <password>) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Scraper sidecar ---
SIDECAR_URL=http://scraper:8000
SIDECAR_SHARED_SECRET=

# --- Data providers (optional) ---
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI (optional fallbacks) ---
# AI is configured from the admin panel (Settings -> AI Configuration);
# values saved there take priority. These are used only when nothing is set there.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
