# -----------------------------------------------------------------------------
# X Monitor - Environment Configuration
# -----------------------------------------------------------------------------

# Web server port
PORT=3000

# SQLite Database storage path
DATABASE_PATH="./data/xmonitor.db"

# Admin Authentication
ADMIN_USERNAME="admin"
# Generate with: npm run hash-password <your_password>
ADMIN_PASSWORD_HASH=""

# Session Secret (cryptographically random 32+ char string)
SESSION_SECRET="change-this-to-a-very-secret-random-32char-key"

# Google Gemini API Key (Server-side AI summaries, scoring, clustering, and translation)
GEMINI_API_KEY=""

# Scraper Sidecar (twscrape Python service)
SIDECAR_URL="http://127.0.0.1:8000"
SIDECAR_SHARED_SECRET="xmonitor-internal-secret-change-me"

# Optional Paid Provider A: Official X API v2 (Pay-per-use)
X_BEARER_TOKEN=""

# Optional Paid Provider B: twitterapi.io (Pay-per-item)
TWITTERAPI_IO_KEY=""

# Optional Alerts: Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# System Timezone
TZ="Asia/Tehran"
